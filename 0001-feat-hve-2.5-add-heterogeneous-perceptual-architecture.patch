+static double linearize_component(double component, uint8_t space) {
+    if (space == HVE_COLOR_SPACE_SRGB || space == HVE_COLOR_SPACE_DISPLAY_P3) {
+        return component <= 0.04045
+                   ? component / 12.92
+                   : pow((component + 0.055) / 1.055, 2.4);
+    }
+    return pow(component, 563.0 / 256.0);
+}
+
+static double encode_component(double component, uint8_t space) {
+    if (space == HVE_COLOR_SPACE_SRGB || space == HVE_COLOR_SPACE_DISPLAY_P3) {
+        return component <= 0.0031308
+                   ? 12.92 * component
+                   : 1.055 * pow(component, 1.0 / 2.4) - 0.055;
+    }
+    return pow(component, 256.0 / 563.0);
+}
+
+static double euclidean3(const double left[3], const double right[3]) {
+    double d0 = left[0] - right[0];
+    double d1 = left[1] - right[1];
+    double d2 = left[2] - right[2];
+    return sqrt(d0 * d0 + d1 * d1 + d2 * d2);
+}
