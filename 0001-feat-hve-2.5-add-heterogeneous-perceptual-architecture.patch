+            abs_tol=1e-16,
+        ),
+        "Oklab sigma mismatch",
+    )
+    _expect(
+        errors,
+        conversion["statuses"] == [member.name for member in ConversionStatus],
+        "conversion status order mismatch",
+    )
+    _expect(
+        errors,
+        conversion["policies"] == [member.name for member in GamutPolicy],
+        "gamut policy order mismatch",
+    )
+
+    conformance = _load_json(ROOT / "evidence" / "hve25_conformance.json")
+    conformance_cr88 = _section(conformance, "cr88")
+    _expect(
+        errors,
+        validation["cr88_random_vectors"] == conformance_cr88["random_vectors"],
+        "random-vector evidence mismatch",
+    )
+    _expect(
+        errors,
+        validation["cr88_total_vectors"] == conformance_cr88["vectors_verified"],
+        "total-vector evidence mismatch",
+    )
+    _expect(
+        errors,
+        validation["cr88_python_c_mismatches"] == conformance_cr88["python_c_byte_mismatches"],
+        "cross-language mismatch count differs from evidence",
+    )
+    _expect(
+        errors,
+        validation["cr88_stream_sha256"] == conformance_cr88["stream_sha256"],
+        "CR88 conformance digest mismatch",
+    )
+
+    golden_path = ROOT / "tests" / "golden_vectors_v25.json"
+    _expect(
+        errors,
+        validation["golden_vectors_v25_sha256"] == _sha256(golden_path),
+        "golden-vector digest mismatch",
+    )
+
+    coverage = _load_json(ROOT / "evidence" / "coverage_2_5.json")
+    coverage_totals = _section(coverage, "totals")
+    _expect(
+        errors,
+        math.isclose(
+            validation["statement_coverage_percent"],
+            coverage_totals["percent_covered"],
+            rel_tol=0.0,
+            abs_tol=1e-12,
+        ),
+        "coverage total mismatch",
+    )
+    coverage_files = _section(coverage, "files")
+    module_floor = min(
+        _section(cast(dict[str, Any], record), "summary")["percent_covered"]
+        for record in coverage_files.values()
+        if isinstance(record, dict)
+    )
+    _expect(
+        errors,
+        math.isclose(
+            validation["minimum_module_coverage_percent"],
+            module_floor,
+            rel_tol=0.0,
+            abs_tol=1e-12,
+        ),
+        "coverage floor mismatch",
+    )
+
+    report = (ROOT / "TEST_REPORT.txt").read_text(encoding="utf-8")
+    _expect(
+        errors,
+        f"{validation['python_tests_passed']} / {validation['python_tests_total']} passed" in report,
+        "historical Python test count is absent from TEST_REPORT.txt",
+    )
+    c11_report = (ROOT / "evidence" / "c11_test_output_v2_5.txt").read_text(encoding="utf-8")
+    _expect(errors, "ALL TESTS PASSED" in c11_report, "C11 final success marker missing")
+    _expect(
+        errors,
+        c11_report.count("PASS:")
