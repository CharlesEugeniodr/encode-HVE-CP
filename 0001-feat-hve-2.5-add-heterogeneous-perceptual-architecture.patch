+static hve_status_t quantize_linear_target(const double linear[3],
+                                           uint8_t space,
+                                           hve_profiled_color_t *color_out,
+                                           int *exact_out) {
+    double bounded[3];
+    size_t i;
+    if (color_out == NULL || exact_out == NULL) {
+        return HVE_ERR_NULL;
+    }
+    clamp_unit(linear, bounded);
+    color_out->state = HVE_COLOR_STATE_VALID;
+    color_out->space = space;
+    *exact_out = 1;
+    for (i = 0u; i < 3u; ++i) {
+        double scaled = encode_component(bounded[i], space) * 255.0;
+        long rounded = (long)floor(scaled + 0.5);
+        uint8_t component;
+        if (rounded < 0L) {
+            rounded = 0L;
+        } else if (rounded > 255L) {
+            rounded = 255L;
+        }
+        component = (uint8_t)rounded;
+        if (fabs(scaled - (double)rounded) > 1e-9) {
+            *exact_out = 0;
+        }
+        if (i == 0u) {
+            color_out->r = component;
+        } else if (i == 1u) {
+            color_out->g = component;
+        } else {
+            color_out->b = component;
+        }
+    }
+    return HVE_OK;
