+static void local_minde_map(const double source_xyz[3],
+                            uint8_t target_space,
+                            double mapped_out[3]) {
+    double origin[3];
+    double chroma;
+    double current_linear[3];
+    double clipped[3];
+    double difference;
+    double minimum;
+    double maximum;
+    int minimum_in_gamut = 1;
+    unsigned iteration;
+
+    xyz_to_oklab_internal(source_xyz, origin);
+    if (origin[0] >= 1.0) {
+        mapped_out[0] = 1.0;
+        mapped_out[1] = 1.0;
+        mapped_out[2] = 1.0;
+        return;
+    }
+    if (origin[0] <= 0.0) {
+        mapped_out[0] = 0.0;
+        mapped_out[1] = 0.0;
+        mapped_out[2] = 0.0;
+        return;
+    }
+    chroma = hypot(origin[1], origin[2]);
+    if (chroma <= 1e-12) {
+        xyz_to_linear_target(source_xyz, target_space, current_linear);
+        clamp_unit(current_linear, mapped_out);
+        return;
+    }
+    minde_candidate(origin[0], origin[1], origin[2], chroma, chroma,
+                    target_space, current_linear, clipped, &difference);
+    if (in_unit_gamut(current_linear)) {
+        clamp_unit(current_linear, mapped_out);
+        return;
+    }
+    if (difference < HVE_GAMUT_MAP_JND) {
+        memcpy(mapped_out, clipped, 3u * sizeof(double));
+        return;
+    }
+
+    minimum = 0.0;
+    maximum = chroma;
+    memcpy(mapped_out, clipped, 3u * sizeof(double));
+    for (iteration = 0u; iteration < 64u; ++iteration) {
+        double current_chroma;
+        if (maximum - minimum <= HVE_GAMUT_MAP_EPSILON) {
+            break;
+        }
+        current_chroma = (minimum + maximum) / 2.0;
+        minde_candidate(origin[0], origin[1], origin[2], chroma, current_chroma,
+                        target_space, current_linear, clipped, &difference);
+        if (minimum_in_gamut != 0 && in_unit_gamut(current_linear)) {
+            minimum = current_chroma;
+            continue;
+        }
+        memcpy(mapped_out, clipped, 3u * sizeof(double));
+        if (difference < HVE_GAMUT_MAP_JND) {
+            if (HVE_GAMUT_MAP_JND - difference < HVE_GAMUT_MAP_EPSILON) {
+                return;
+            }
+            minimum_in_gamut = 0;
+            minimum = current_chroma;
+        } else {
+            maximum = current_chroma;
+        }
+    }
 }
 
