+
+hve_status_t hve_delta_e_ok(const hve_profiled_color_t *left,
+                            const hve_profiled_color_t *right,
+                            double *delta_out) {
+    double left_lab[3];
+    double right_lab[3];
+    hve_status_t status;
+    if (delta_out == NULL) {
+        return HVE_ERR_NULL;
+    }
+    status = hve_rgb_to_oklab(left, left_lab);
+    if (status != HVE_OK) {
+        return status;
+    }
+    status = hve_rgb_to_oklab(right, right_lab);
+    if (status != HVE_OK) {
+        return status;
+    }
+    *delta_out = euclidean3(left_lab, right_lab);
+    return HVE_OK;
+}
+
+hve_status_t hve_gaussian_conductance(double delta_e,
+                                      double sigma,
+                                      double *weight_out) {
+    if (weight_out == NULL) {
+        return HVE_ERR_NULL;
+    }
+    if (!isfinite(delta_e) || delta_e < 0.0 || !isfinite(sigma) || sigma <= 0.0) {
+        return HVE_ERR_RANGE;
+    }
+    *weight_out = exp(-(delta_e * delta_e) / (2.0 * sigma * sigma));
+    return HVE_OK;
+}
+
+hve_status_t hve_perceptual_edge_conductance(
+    const hve_profiled_color_t *left,
+    const hve_profiled_color_t *right,
+    double sigma,
+    double *weight_out) {
+    uint16_t distance;
+    double delta;
+    hve_status_t status;
+    if (weight_out == NULL) {
+        return HVE_ERR_NULL;
+    }
+    status = hve_chromatic_graph_distance(left, right, &distance);
+    if (status != HVE_OK) {
+        return status;
+    }
+    if (distance != 1u) {
+        return HVE_ERR_DISCONNECTED;
+    }
+    status = hve_delta_e_ok(left, right, &delta);
+    if (status != HVE_OK) {
+        return status;
+    }
+    return hve_gaussian_conductance(delta, sigma, weight_out);
+}
+
+hve_status_t hve_chromatic_laplacian_perceptual_local(
+    const hve_profiled_color_t *center_color,
+    double center_value,
+    const hve_profiled_color_t *neighbor_colors,
+    const double *neighbor_values,
+    size_t neighbor_count,
+    double sigma,
+    double *value_out) {
+    double result = 0.0;
+    size_t i;
+    hve_status_t status;
+    if (center_color == NULL || value_out == NULL ||
+        (neighbor_count > 0u && (neighbor_colors == NULL || neighbor_values == NULL))) {
+        return HVE_ERR_NULL;
+    }
+    if (neighbor_count > HVE_CHROMATIC_MAX_NEIGHBORS) {
+        return HVE_ERR_RANGE;
+    }
+    for (i = 0u; i < neighbor_count; ++i) {
+        double weight;
+        status = hve_perceptual_edge_conductance(
+            center_color, &neighbor_colors[i], sigma, &weight
+        );
+        if (status != HVE_OK) {
+            return status;
+        }
+        result += weight * (center_value - neighbor_values[i]);
+    }
+    *value_out = result;
+    return HVE_OK;
+}
+
