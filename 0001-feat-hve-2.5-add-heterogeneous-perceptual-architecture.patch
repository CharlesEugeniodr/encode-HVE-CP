+def pack_chi_refined88(
+    state: HVERefinedState,
+    color: HVEProfiledColor,
+) -> bytes:
+    """Encode one heterogeneous profiled state as CR80 plus one metadata byte."""
+
+    state.validate()
+    color.validate()
+    if color.state is ColorState.NO_COLOR:
+        carrier = HVEColor.no_color()
+    else:
+        carrier = HVEColor.rgb(color.r, color.g, color.b)
+    metadata = (int(color.space) << CR88_METADATA_COLOR_SPACE_SHIFT) | (
+        int(color.state) << CR88_METADATA_COLOR_STATE_SHIFT
+    )
+    return pack_chi_refined80(state, carrier) + bytes((metadata,))
+
+
+def unpack_chi_refined88(
+    data: bytes,
+) -> tuple[HVERefinedState, HVEProfiledColor]:
+    """Decode one CR88 word and enforce its metadata/carrier truth table."""
+
+    if not isinstance(data, bytes) or len(data) != CHI_REFINED88_BYTE_WIDTH:
+        raise HVEError("CR88 word must contain exactly 11 bytes")
+    metadata = data[-1]
+    if metadata & CR88_METADATA_RESERVED_MASK:
+        raise HVEError("CR88 reserved metadata bits must be zero")
+    try:
+        space = ColorSpace((metadata >> CR88_METADATA_COLOR_SPACE_SHIFT) & 0x03)
+        color_state = ColorState((metadata >> CR88_METADATA_COLOR_STATE_SHIFT) & 0x03)
+    except ValueError as exc:  # Defensive: both enums currently occupy every two-bit code.
+        raise HVEError("invalid CR88 chromatic metadata") from exc
+    state, carrier = unpack_chi_refined80(data[:CHI_REFINED_BYTE_WIDTH])
+    if carrier.present and color_state is ColorState.NO_COLOR:
+        raise HVEError("CR88 NoColor metadata conflicts with an RGB carrier")
+    if not carrier.present and color_state is not ColorState.NO_COLOR:
+        raise HVEError("CR88 RGB metadata requires a present RGB carrier")
+    color = HVEProfiledColor(color_state, space, carrier.r, carrier.g, carrier.b)
+    color.validate()
+    return state, color
+
+
+def encode_states_chi_refined88(
+    states: Iterable[tuple[HVERefinedState, HVEProfiledColor]],
+) -> bytes:
+    """Serialize heterogeneous profiled states as concatenated CR88 words."""
+
+    return b"".join(pack_chi_refined88(state, color) for state, color in states)
+
