+from __future__ import annotations
+
+import binascii
+import math
+
+import numpy as np
+import pytest
+
+from hve.chromatic import HVEColor
+from hve.chromatic_topology import (
+    OKLAB_GAUSSIAN_SIGMA_DEFAULT,
+    ColorSpace,
+    ConversionStatus,
+    GamutPolicy,
+    HVEProfiledColor,
+    chromatic_graph_distance,
+    chromatic_neighbors,
+    chromatic_perceptual_laplacian_at,
+    convert_profiled_color,
+    convert_profiled_color_detailed,
+    convert_refined_chromatic_state,
+    gaussian_conductance,
+    perceptual_edge_conductance,
+)
+from hve.core import HVEError
+from hve.protocol import (
+    CHI_REFINED88_BYTE_WIDTH,
+    CR88_TRANSPORT_BIT_WIDTH,
+    CR88_TRANSPORT_CARDINALITY,
+    CR88_TRANSPORT_COLOR_CARDINALITY,
+    PROFILE_CHI_REFINED88_HETEROGENEOUS,
+    decode_states_chi_refined88,
+    encode_states_chi_refined88,
+    frame_payload_size,
+    make_frame,
+    make_heterogeneous_chi_refined_frame,
+    pack_chi_refined88,
+    parse_frame,
+    parse_heterogeneous_chi_refined_frame,
+    unpack_chi_refined88,
+)
+from hve.refined import FULL_REFINED_CARDINALITY, HVERefinedState
+
+REFERENCE_STATE = HVERefinedState(42, 731, 1_001, 1, 3, 217, 1_079, 6)
+
+
+@pytest.mark.parametrize(
+    ("color", "metadata"),
+    [
+        (HVEProfiledColor.no_color(), 0x00),
+        (HVEProfiledColor.valid(ColorSpace.SRGB, 1, 2, 3), 0x50),
+        (HVEProfiledColor.valid(ColorSpace.DISPLAY_P3, 1, 2, 3), 0x90),
+        (HVEProfiledColor.valid(ColorSpace.ADOBE_RGB_1998, 1, 2, 3), 0xD0),
+        (HVEProfiledColor.uncalibrated(1, 2, 3), 0x20),
+    ],
+)
+def test_cr88_layout_and_roundtrip(color: HVEProfiledColor, metadata: int) -> None:
+    word = pack_chi_refined88(REFERENCE_STATE, color)
+    assert len(word) == CHI_REFINED88_BYTE_WIDTH
+    assert word[-1] == metadata
+    assert unpack_chi_refined88(word) == (REFERENCE_STATE, color)
+
+
+def test_cr88_is_cr80_plus_metadata_not_a_new_dense_rank() -> None:
+    color = HVEProfiledColor.valid(ColorSpace.DISPLAY_P3, 0xA1, 0xB2, 0xC3)
+    word = pack_chi_refined88(REFERENCE_STATE, color)
+    from hve.chi_refined import pack_chi_refined80
+
+    assert word[:10] == pack_chi_refined80(REFERENCE_STATE, HVEColor.rgb(0xA1, 0xB2, 0xC3))
+    assert CR88_TRANSPORT_COLOR_CARDINALITY == 1 + 4 * 2**24
+    assert CR88_TRANSPORT_CARDINALITY == FULL_REFINED_CARDINALITY * (1 + 4 * 2**24)
+    assert CR88_TRANSPORT_BIT_WIDTH == 82
+
+
+@pytest.mark.parametrize(
+    "metadata",
+    [
+        0x01,  # nonzero reserved bit
+        0x30,  # reserved color state
+        0x40,  # NoColor with sRGB
+        0x10,  # valid color without a declared space
+        0x60,  # uncalibrated color with sRGB
+    ],
+)
+def test_cr88_rejects_invalid_metadata(metadata: int) -> None:
+    valid = bytearray(
+        pack_chi_refined88(
+            REFERENCE_STATE,
+            HVEProfiledColor.valid(ColorSpace.SRGB, 1, 2, 3),
+        )
+    )
+    valid[-1] = metadata
+    with pytest.raises(HVEError):
+        unpack_chi_refined88(bytes(valid))
+
+
+def test_cr88_rejects_carrier_metadata_disagreement() -> None:
+    rgb_word = bytearray(
+        pack_chi_refined88(
+            REFERENCE_STATE,
+            HVEProfiledColor.valid(ColorSpace.SRGB, 0, 0, 0),
+        )
+    )
+    rgb_word[-1] = 0x00
+    with pytest.raises(HVEError, match="conflicts"):
+        unpack_chi_refined88(bytes(rgb_word))
+
+    no_color_word = bytearray(pack_chi_refined88(REFERENCE_STATE, HVEProfiledColor.no_color()))
+    no_color_word[-1] = 0x50
+    with pytest.raises(HVEError, match="requires"):
+        unpack_chi_refined88(bytes(no_color_word))
+
+
+def test_cr88_payload_and_hve2_profile_05_roundtrip() -> None:
+    states = (
+        (REFERENCE_STATE, HVEProfiledColor.no_color()),
+        (REFERENCE_STATE, HVEProfiledColor.valid(ColorSpace.SRGB, 255, 0, 0)),
+        (REFERENCE_STATE, HVEProfiledColor.valid(ColorSpace.DISPLAY_P3, 0, 255, 0)),
+        (REFERENCE_STATE, HVEProfiledColor.valid(ColorSpace.ADOBE_RGB_1998, 0, 0, 255)),
+        (REFERENCE_STATE, HVEProfiledColor.uncalibrated(127, 128, 129)),
+    )
+    payload = encode_states_chi_refined88(states)
+    assert len(payload) == 11 * len(states)
+    assert decode_states_chi_refined88(payload, len(states)) == list(states)
+    frame = make_heterogeneous_chi_refined_frame(states)
+    assert frame[:6] == b"HVE2\x02\x05"
+    assert frame[6:8] == b"\x00\x00"
+    assert len(frame) == 16 + len(payload)
+    assert int.from_bytes(frame[12:16], "big") == binascii.crc32(payload) & 0xFFFFFFFF
+    assert parse_heterogeneous_chi_refined_frame(frame) == list(states)
+    profile, flags, count, decoded_payload = parse_frame(frame)
+    assert (profile, flags, count, decoded_payload) == (
+        PROFILE_CHI_REFINED88_HETEROGENEOUS,
+        0,
+        len(states),
+        payload,
+    )
+
+
+def test_profile_05_flags_crc_and_lengths_are_strict() -> None:
+    payload = pack_chi_refined88(REFERENCE_STATE, HVEProfiledColor.no_color())
+    assert frame_payload_size(PROFILE_CHI_REFINED88_HETEROGENEOUS, 3) == 33
+    with pytest.raises(HVEError, match="zero frame flags"):
+        make_frame(PROFILE_CHI_REFINED88_HETEROGENEOUS, 1, payload, flags=1)
+    frame = bytearray(make_frame(PROFILE_CHI_REFINED88_HETEROGENEOUS, 1, payload, flags=0))
+    frame[-1] ^= 0x10
+    with pytest.raises(HVEError, match="CRC"):
+        parse_frame(bytes(frame))
+    with pytest.raises(HVEError, match="length"):
+        decode_states_chi_refined88(payload[:-1], 1)
+
