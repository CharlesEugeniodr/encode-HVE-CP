+        state.tau_micro,
+        state.tau_nano,
+        state.phi,
+    )
+
+
+def _python_color(color: CProfiledColor) -> HVEProfiledColor:
+    return HVEProfiledColor(
+        ColorState(color.state),
+        ColorSpace(color.space),
+        color.r,
+        color.g,
+        color.b,
+    )
+
+
+def _build_c_library(directory: Path) -> ctypes.CDLL:
+    compiler = os.environ.get("CC", "cc")
+    library = directory / "libhve25_conformance.so"
+    command = [
+        compiler,
+        "-std=c11",
+        "-O2",
+        "-Wall",
+        "-Wextra",
+        "-Wpedantic",
+        "-Werror",
+        "-Wconversion",
+        "-Wshadow",
+        "-fPIC",
+        "-shared",
+        f"-I{ROOT / 'c' / 'include'}",
+        str(ROOT / "c" / "src" / "hve.c"),
+        "-lm",
+        "-o",
+        str(library),
+    ]
+    subprocess.run(command, check=True, capture_output=True, text=True)
+    loaded = ctypes.CDLL(str(library))
+    byte_pointer = ctypes.POINTER(ctypes.c_uint8)
+    loaded.hve_chi_refined88_pack.argtypes = [
+        ctypes.POINTER(CRefinedState),
+        ctypes.POINTER(CProfiledColor),
+        byte_pointer,
+    ]
+    loaded.hve_chi_refined88_pack.restype = ctypes.c_int
+    loaded.hve_chi_refined88_unpack.argtypes = [
+        byte_pointer,
+        ctypes.POINTER(CRefinedState),
+        ctypes.POINTER(CProfiledColor),
+    ]
+    loaded.hve_chi_refined88_unpack.restype = ctypes.c_int
+    loaded.hve_profiled_color_convert.argtypes = [
+        ctypes.POINTER(CProfiledColor),
+        ctypes.c_uint8,
+        ctypes.c_int,
+        ctypes.POINTER(CConversionResult),
+    ]
+    loaded.hve_profiled_color_convert.restype = ctypes.c_int
+    loaded.hve_perceptual_edge_conductance.argtypes = [
+        ctypes.POINTER(CProfiledColor),
+        ctypes.POINTER(CProfiledColor),
+        ctypes.c_double,
+        ctypes.POINTER(ctypes.c_double),
+    ]
+    loaded.hve_perceptual_edge_conductance.restype = ctypes.c_int
+    return loaded
+
+
+def _random_state(rng: random.Random) -> HVERefinedState:
+    return HVERefinedState(
+        rng.randrange(360),
+        rng.randrange(1_000),
+        rng.randrange(1_080),
+        rng.randrange(2),
+        rng.randrange(5),
+        rng.randrange(1_000),
+        rng.randrange(1_080),
+        rng.randrange(9),
+    )
+
+
+def _random_color(rng: random.Random, index: int) -> HVEProfiledColor:
+    rgb = (rng.randrange(256), rng.randrange(256), rng.randrange(256))
+    selector = index % 17
+    if selector == 0:
+        return HVEProfiledColor.no_color()
+    if selector == 1:
+        return HVEProfiledColor.uncalibrated(*rgb)
+    space = (ColorSpace.SRGB, ColorSpace.DISPLAY_P3, ColorSpace.ADOBE_RGB_1998)[index % 3]
+    return HVEProfiledColor.valid(space, *rgb)
+
+
+def _verify_cr88_vector(
+    library: ctypes.CDLL,
+    state: HVERefinedState,
+    color: HVEProfiledColor,
+    digest: hashlib._Hash,
+) -> None:
+    python_word = pack_chi_refined88(state, color)
+    c_state = _c_state(state)
+    c_color = _c_color(color)
+    c_word = (ctypes.c_uint8 * 11)()
+    if library.hve_chi_refined88_pack(
+        ctypes.byref(c_state), ctypes.byref(c_color), c_word
+    ) != 0:
+        raise AssertionError("C11 CR88 encoder rejected a valid state")
+    if bytes(c_word) != python_word:
+        raise AssertionError("Python/C11 CR88 byte mismatch")
+    decoded_state = CRefinedState()
+    decoded_color = CProfiledColor()
+    if library.hve_chi_refined88_unpack(
+        c_word, ctypes.byref(decoded_state), ctypes.byref(decoded_color)
+    ) != 0:
+        raise AssertionError("C11 CR88 decoder rejected its own word")
+    if _python_state(decoded_state) != state or _python_color(decoded_color) != color:
+        raise AssertionError("C11 CR88 semantic round-trip mismatch")
+    if unpack_chi_refined88(python_word) != (state, color):
+        raise AssertionError("Python CR88 semantic round-trip mismatch")
+    digest.update(python_word)
+
+
+def _conversion_record(
+    source: HVEProfiledColor,
+    target: ColorSpace,
+    policy: GamutPolicy,
+) -> dict[str, object]:
+    result = convert_profiled_color_detailed(source, target, policy)
+    return {
+        "source": {
+            "space": source.space.name,
+            "rgb8": [source.r, source.g, source.b],
+        },
+        "target_space": target.name,
+        "policy": policy.name,
+        "status": result.status.name,
+        "result_rgb8": (
+            None if result.color is None else [result.color.r, result.color.g, result.color.b]
+        ),
+        "out_of_gamut": result.out_of_gamut,
+        "target_linear_unconstrained": result.target_linear_unconstrained,
+        "quantization_delta_e_ok": result.quantization_delta_e_ok,
+    }
+
+
+def _verify_conversions(library: ctypes.CDLL) -> list[dict[str, object]]:
+    srgb_red = HVEProfiledColor.valid(ColorSpace.SRGB, 255, 0, 0)
+    p3_red = HVEProfiledColor.valid(ColorSpace.DISPLAY_P3, 255, 0, 0)
+    cases = (
+        (srgb_red, ColorSpace.DISPLAY_P3, GamutPolicy.REJECT),
+        (p3_red, ColorSpace.SRGB, GamutPolicy.REJECT),
+        (p3_red, ColorSpace.SRGB, GamutPolicy.CLIP),
+        (p3_red, ColorSpace.SRGB, GamutPolicy.MAP_OKLCH_MINDE),
+    )
+    records: list[dict[str, object]] = []
+    for source, target, policy in cases:
+        python_result = convert_profiled_color_detailed(source, target, policy)
+        c_source = _c_color(source)
+        c_result = CConversionResult()
+        status = library.hve_profiled_color_convert(
+            ctypes.byref(c_source), int(target), int(policy), ctypes.byref(c_result)
+        )
+        if status != 0:
+            raise AssertionError("C11 typed conversion returned an engine error")
+        if c_result.status != int(python_result.status):
+            raise AssertionError("Python/C11 conversion-status mismatch")
+        if bool(c_result.has_color) != (python_result.color is not None):
+            raise AssertionError("Python/C11 conversion-presence mismatch")
+        if bool(c_result.out_of_gamut) != python_result.out_of_gamut:
+            raise AssertionError("Python/C11 gamut diagnostic mismatch")
+        if python_result.color is not None and _python_color(c_result.color) != python_result.color:
+            raise AssertionError("Python/C11 converted RGB8 mismatch")
+        if python_result.target_linear_unconstrained is not None:
+            for c_value, py_value in zip(
+                c_result.target_linear_unconstrained,
+                python_result.target_linear_unconstrained,
+            ):
+                if not math.isclose(c_value, py_value, rel_tol=1e-12, abs_tol=1e-12):
+                    raise AssertionError("Python/C11 target-linear diagnostic mismatch")
+        if python_result.quantization_delta_e_ok is None:
+            if not math.isnan(c_result.quantization_delta_e_ok):
+                raise AssertionError("C11 reject result must expose NaN quantization error")
+        elif not math.isclose(
+            c_result.quantization_delta_e_ok,
+            python_result.quantization_delta_e_ok,
+            rel_tol=1e-11,
+            abs_tol=1e-12,
+        ):
+            raise AssertionError("Python/C11 conversion-error mismatch")
+        records.append(_conversion_record(source, target, policy))
+    return records
+
+
+def _perceptual_vectors(library: ctypes.CDLL) -> dict[str, object]:
+    colors = [
+        HVEProfiledColor.valid(ColorSpace.SRGB, 0, 0, 0),
+        HVEProfiledColor.valid(ColorSpace.SRGB, 1, 0, 0),
+        HVEProfiledColor.valid(ColorSpace.SRGB, 2, 0, 0),
+    ]
+    weights = [
+        perceptual_edge_conductance(colors[0], colors[1]),
+        perceptual_edge_conductance(colors[1], colors[2]),
+    ]
+    for index, weight in enumerate(weights):
+        c_left = _c_color(colors[index])
+        c_right = _c_color(colors[index + 1])
+        c_weight = ctypes.c_double()
+        status = library.hve_perceptual_edge_conductance(
+            ctypes.byref(c_left),
+            ctypes.byref(c_right),
+            OKLAB_GAUSSIAN_SIGMA_DEFAULT,
+            ctypes.byref(c_weight),
+        )
+        if status != 0 or not math.isclose(
+            c_weight.value, weight, rel_tol=1e-11, abs_tol=1e-13
+        ):
+            raise AssertionError("Python/C11 perceptual conductance mismatch")
+    w01, w12 = weights
+    laplacian = [
+        [w01, -w01, 0.0],
+        [-w01, w01 + w12, -w12],
+        [0.0, -w12, w12],
+    ]
+    return {
+        "profile": "hve-chi-oklab/v1",
+        "oklab_native_scale": True,
+        "sigma": OKLAB_GAUSSIAN_SIGMA_DEFAULT,
+        "jnd_delta_e_ok": 0.02,
+        "weight_at_jnd": math.exp(-1.0),
+        "vertices": [[color.r, color.g, color.b] for color in colors],
+        "edge_weights": weights,
+        "laplacian": laplacian,
+        "row_sums": [sum(row) for row in laplacian],
+    }
+
+
+def _golden_vectors(
+    library: ctypes.CDLL,
+    conversions: list[dict[str, object]],
+    perceptual: dict[str, object],
+) -> dict[str, object]:
+    zero = HVERefinedState(0, 0, 0, 0, 0, 0, 0, 0)
+    maximum = HVERefinedState(359, 999, 1_079, 1, 4, 999, 1_079, 8)
+    reference = HVERefinedState(42, 731, 1_001, 1, 3, 217, 1_079, 6)
+    entries = [
+        ("zero_no_color", zero, HVEProfiledColor.no_color()),
+        ("zero_srgb_black", zero, HVEProfiledColor.valid(ColorSpace.SRGB, 0, 0, 0)),
+        (
+            "maximum_p3_white",
+            maximum,
+            HVEProfiledColor.valid(ColorSpace.DISPLAY_P3, 255, 255, 255),
+        ),
+        (
+            "reference_adobe_midpoint",
+            reference,
+            HVEProfiledColor.valid(ColorSpace.ADOBE_RGB_1998, 128, 128, 128),
+        ),
+        (
+            "reference_uncalibrated",
+            reference,
+            HVEProfiledColor.uncalibrated(1, 127, 254),
+        ),
+    ]
+    words = []
+    for name, state, color in entries:
+        _verify_cr88_vector(library, state, color, hashlib.sha256())
+        word = pack_chi_refined88(state, color)
+        words.append(
+            {
+                "name": name,
+                "geometry": [
+                    state.theta,
+                    state.theta_micro,
+                    state.theta_nano,
+                    state.s,
+                    state.tau,
+                    state.tau_micro,
+                    state.tau_nano,
+                    state.phi,
+                ],
+                "color_state": color.state.name,
+                "color_space": color.space.name,
+                "rgb8": [color.r, color.g, color.b],
+                "cr80_hex": word[:10].hex(),
+                "metadata_hex": word[10:].hex(),
+                "cr88_hex": word.hex(),
+            }
+        )
+    frame_states = [(state, color) for _, state, color in entries]
+    frame = make_heterogeneous_chi_refined_frame(frame_states)
+    payload = frame[16:]
+    return {
+        "schema": "hve-2.5-golden-vectors/v1",
+        "engine_version": __version__,
+        "serialization": {
+            "profile": "0x05",
+            "physical_bits_per_word": 88,
+            "cr80_bits": 80,
+            "metadata_bits": 8,
+            "payload_crc32_iso_hdlc_hex": f"{binascii.crc32(payload) & 0xFFFFFFFF:08x}",
+            "words": words,
+            "frame_hex": frame.hex(),
+        },
+        "invalid_metadata": [
+            {"metadata_hex": "01", "reason": "nonzero reserved bits"},
+            {"metadata_hex": "30", "reason": "reserved color_state"},
+            {"metadata_hex": "40", "reason": "NoColor with sRGB"},
+            {"metadata_hex": "10", "reason": "valid RGB without color_space"},
+            {"metadata_hex": "60", "reason": "uncalibrated RGB with sRGB"},
+        ],
+        "conversions": conversions,
+        "perceptual_laplacian": perceptual,
+    }
+
+
+def run(random_vectors: int) -> tuple[dict[str, object], dict[str, object]]:
+    started = time.perf_counter()
+    rng = random.Random(SEED)
+    digest = hashlib.sha256()
+    with tempfile.TemporaryDirectory(prefix="hve25-conformance-") as temporary:
+        library = _build_c_library(Path(temporary))
+        boundary_states = (
+            HVERefinedState(0, 0, 0, 0, 0, 0, 0, 0),
+            HVERefinedState(359, 999, 1_079, 1, 4, 999, 1_079, 8),
+            HVERefinedState(42, 731, 1_001, 1, 3, 217, 1_079, 6),
+        )
+        boundary_colors = (
+            HVEProfiledColor.no_color(),
+            HVEProfiledColor.valid(ColorSpace.SRGB, 0, 0, 0),
+            HVEProfiledColor.valid(ColorSpace.DISPLAY_P3, 255, 255, 255),
+            HVEProfiledColor.valid(ColorSpace.ADOBE_RGB_1998, 128, 128, 128),
+            HVEProfiledColor.uncalibrated(1, 127, 254),
+        )
+        verified = 0
+        for state in boundary_states:
+            for color in boundary_colors:
+                _verify_cr88_vector(library, state, color, digest)
+                verified += 1
+        for index in range(random_vectors):
+            _verify_cr88_vector(
+                library,
+                _random_state(rng),
+                _random_color(rng, index),
+                digest,
+            )
+            verified += 1
+
+        reference = boundary_states[-1]
+        valid_word = bytearray(
+            pack_chi_refined88(
+                reference,
+                HVEProfiledColor.valid(ColorSpace.SRGB, 1, 2, 3),
+            )
+        )
+        invalid_checked = 0
+        for metadata in (0x01, 0x30, 0x40, 0x10, 0x60):
+            invalid_word = bytearray(valid_word)
+            invalid_word[-1] = metadata
+            try:
+                unpack_chi_refined88(bytes(invalid_word))
+            except HVEError:
+                pass
+            else:
+                raise AssertionError("Python accepted invalid CR88 metadata")
+            c_word = (ctypes.c_uint8 * 11).from_buffer_copy(invalid_word)
+            if library.hve_chi_refined88_unpack(
+                c_word, ctypes.byref(CRefinedState()), ctypes.byref(CProfiledColor())
+            ) == 0:
+                raise AssertionError("C11 accepted invalid CR88 metadata")
+            invalid_checked += 1
+
+        conversions = _verify_conversions(library)
+        perceptual = _perceptual_vectors(library)
+        golden = _golden_vectors(library, conversions, perceptual)
+
+    evidence = {
+        "schema": "hve-2.5-cross-language-conformance/v1",
+        "engine_version": __version__,
+        "status": "passed",
+        "seed": SEED,
+        "cr88": {
+            "physical_bits": 88,
+            "raw_cr80_bits": 80,
+            "transport_color_cardinality": CR88_TRANSPORT_COLOR_CARDINALITY,
+            "transport_cardinality": CR88_TRANSPORT_CARDINALITY,
+            "minimum_dense_bits_for_transport_domain": CR88_TRANSPORT_BIT_WIDTH,
+            "vectors_verified": verified,
+            "random_vectors": random_vectors,
+            "invalid_metadata_cases_rejected": invalid_checked,
+            "python_c_byte_mismatches": 0,
+            "stream_sha256": digest.hexdigest(),
+        },
+        "conversion_cases_cross_checked": len(conversions),
+        "perceptual_edges_cross_checked": 2,
+        "environment": {
+            "python": sys.version,
+            "platform": platform.platform(),
+            "compiler": os.environ.get("CC", "cc"),
+        },
+        "elapsed_seconds_diagnostic": time.perf_counter() - started,
+    }
+    return evidence, golden
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--vectors", type=int, default=DEFAULT_RANDOM_VECTORS)
+    parser.add_argument(
+        "--output",
+        type=Path,
+        default=ROOT / "evidence" / "hve25_conformance.json",
+    )
+    parser.add_argument(
+        "--golden",
+        type=Path,
+        default=ROOT / "tests" / "golden_vectors_v25.json",
+    )
+    args = parser.parse_args()
+    if args.vectors < 0:
+        raise SystemExit("--vectors must be nonnegative")
+    evidence, golden = run(args.vectors)
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.golden.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(evidence, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    args.golden.write_text(json.dumps(golden, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    print(json.dumps(evidence, indent=2, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
