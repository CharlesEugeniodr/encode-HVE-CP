+    benchmark = _section(validation, "benchmark")
+    cpython_benchmark = _load_json(ROOT / "evidence" / "hve25_cpython_benchmark.json")
+    c11_benchmark = _load_json(ROOT / "evidence" / "hve25_c11_benchmark.json")
+    _expect(
+        errors,
+        benchmark["cpython_states"] == cpython_benchmark["sample_size"],
+        "CPython benchmark sample mismatch",
+    )
+    _expect(
+        errors,
+        benchmark["c11_states"] == c11_benchmark["states_per_repetition"],
+        "C11 benchmark sample mismatch",
+    )
+    _expect(
+        errors,
+        benchmark["repetitions"]
+        == cpython_benchmark["repetitions"]
+        == c11_benchmark["repetitions"],
+        "benchmark repetition mismatch",
+    )
+    _expect(
+        errors,
+        benchmark["reported_operations"]
+        == len(cpython_benchmark["operations"]) + len(c11_benchmark["operations"]),
+        "benchmark operation count mismatch",
+    )
