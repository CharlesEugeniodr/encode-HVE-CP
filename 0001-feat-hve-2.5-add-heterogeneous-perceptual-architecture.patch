+static void matvec3(const double matrix[3][3],
+                    const double vector[3],
+                    double output[3]) {
+    double result[3];
+    size_t row;
+    for (row = 0u; row < 3u; ++row) {
+        result[row] = matrix[row][0] * vector[0] +
+                      matrix[row][1] * vector[1] +
+                      matrix[row][2] * vector[2];
+    }
+    memcpy(output, result, sizeof(result));
