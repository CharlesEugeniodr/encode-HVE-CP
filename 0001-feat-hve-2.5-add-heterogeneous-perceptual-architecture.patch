+    encoded[0] = (double)color->r / 255.0;
+    encoded[1] = (double)color->g / 255.0;
+    encoded[2] = (double)color->b / 255.0;
+    linear[0] = linearize_component(encoded[0], color->space);
+    linear[1] = linearize_component(encoded[1], color->space);
