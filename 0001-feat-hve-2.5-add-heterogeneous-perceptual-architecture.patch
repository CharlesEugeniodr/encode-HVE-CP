+"""Validate the HVE 2.5 article-to-repository architecture contract."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+from pathlib import Path
+from typing import Any, cast
+
+from hve import __version__
+from hve.chi_refined import (
+    CHI_REFINED_BIT_WIDTH,
+    CHI_REFINED_BYTE_WIDTH,
+    CHI_REFINED_CARDINALITY,
+)
+from hve.chromatic import COLOR_POINTED_CARDINALITY
+from hve.chromatic_topology import (
+    OKLAB_GAUSSIAN_SIGMA_DEFAULT,
+    OKLAB_JND,
+    PROFILED_CHI_REFINED_BIT_WIDTH,
+    PROFILED_CHI_REFINED_CARDINALITY,
+    PROFILED_COLOR_CARDINALITY,
+    ColorSpace,
+    ConversionStatus,
+    GamutPolicy,
+    HVEProfiledColor,
+)
+from hve.core import (
+    BASE_CARDINALITY,
+    BASE_LAYOUT_CANONICAL_V2,
+    BASE_LAYOUT_LEGACY_V1,
+    BASE_RESERVED_WORDS,
+)
+from hve.protocol import (
+    CHI_REFINED88_BYTE_WIDTH,
+    CR88_METADATA_RESERVED_MASK,
+    CR88_TRANSPORT_BIT_WIDTH,
+    CR88_TRANSPORT_CARDINALITY,
+    CR88_TRANSPORT_COLOR_CARDINALITY,
+    PROFILE_CHI_REFINED88_HETEROGENEOUS,
+    pack_chi_refined88,
+)
+from hve.refined import FULL_REFINED_CARDINALITY, HVERefinedState
+
+ROOT = Path(__file__).resolve().parents[1]
+CONTRACT_PATH = ROOT / "docs" / "article_data_v2_5.json"
+
+
+def _load_json(path: Path) -> dict[str, Any]:
+    decoded = json.loads(path.read_text(encoding="utf-8"))
+    if not isinstance(decoded, dict):
+        raise TypeError(f"{path} must contain a JSON object")
+    return cast(dict[str, Any], decoded)
+
+
+def _section(data: dict[str, Any], name: str) -> dict[str, Any]:
+    value = data.get(name)
+    if not isinstance(value, dict):
+        raise TypeError(f"{name} must be a JSON object")
+    return cast(dict[str, Any], value)
+
+
+def _sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def _expect(errors: list[str], condition: bool, message: str) -> None:
+    if not condition:
+        errors.append(message)
+
+
+def main() -> int:
+    data = _load_json(CONTRACT_PATH)
+    errors: list[str] = []
+
+    finite = _section(data, "finite_core")
+    refined = _section(data, "refined_geometry")
+    profiled = _section(data, "profiled_chromatic_domain")
+    cr88 = _section(data, "cr88")
+    perceptual = _section(data, "perceptual_conductance")
+    conversion = _section(data, "typed_conversion")
+    validation = _section(data, "validation")
+
+    _expect(errors, data["engine_version"] == __version__, "engine version mismatch")
+    _expect(errors, finite["cardinality"] == BASE_CARDINALITY, "BASE cardinality mismatch")
+    _expect(
+        errors,
+        finite["reserved_base15_words"] == BASE_RESERVED_WORDS,
+        "BASE15 reserved-word mismatch",
+    )
+    _expect(
+        errors,
+        finite["canonical_layout"]["id"] == BASE_LAYOUT_CANONICAL_V2,
+        "canonical layout mismatch",
+    )
+    _expect(
+        errors,
+        finite["legacy_layout"]["id"] == BASE_LAYOUT_LEGACY_V1,
+        "legacy layout mismatch",
+    )
+
+    _expect(
+        errors,
+        int(refined["cardinality_decimal"]) == FULL_REFINED_CARDINALITY,
+        "refined cardinality mismatch",
+    )
+    _expect(
+        errors,
+        refined["raw_pointed_color_cardinality"] == COLOR_POINTED_CARDINALITY,
+        "pointed color cardinality mismatch",
+    )
+    _expect(
+        errors,
+        int(refined["raw_product_cardinality_decimal"]) == CHI_REFINED_CARDINALITY,
+        "raw refined product mismatch",
+    )
+    _expect(errors, refined["canonical_rank_bits"] == CHI_REFINED_BIT_WIDTH, "CR80 bit mismatch")
+    _expect(
+        errors,
+        refined["canonical_rank_bytes"] == CHI_REFINED_BYTE_WIDTH,
+        "CR80 byte mismatch",
+    )
+
+    _expect(
+        errors,
+        profiled["cardinality"] == PROFILED_COLOR_CARDINALITY,
+        "profiled color cardinality mismatch",
+    )
+    _expect(
+        errors,
+        int(profiled["refined_product_cardinality_decimal"])
+        == PROFILED_CHI_REFINED_CARDINALITY,
+        "profiled refined product mismatch",
+    )
+    _expect(
+        errors,
+        profiled["hypothetical_dense_rank_bits"] == PROFILED_CHI_REFINED_BIT_WIDTH,
+        "profiled dense width mismatch",
+    )
+
+    _expect(
+        errors,
+        int(cr88["profile_id_hex"], 16) == PROFILE_CHI_REFINED88_HETEROGENEOUS,
+        "HVE2 profile 0x05 mismatch",
+    )
+    _expect(errors, cr88["word_bytes"] == CHI_REFINED88_BYTE_WIDTH, "CR88 byte mismatch")
+    _expect(
+        errors,
+        cr88["transport_color_cardinality"] == CR88_TRANSPORT_COLOR_CARDINALITY,
+        "CR88 color-domain mismatch",
+    )
+    _expect(
+        errors,
+        int(cr88["transport_cardinality_decimal"]) == CR88_TRANSPORT_CARDINALITY,
+        "CR88 transport-domain mismatch",
+    )
+    _expect(
+        errors,
+        cr88["minimum_dense_bits_for_valid_transport_domain"] == CR88_TRANSPORT_BIT_WIDTH,
+        "CR88 dense-width mismatch",
+    )
+    _expect(
+        errors,
