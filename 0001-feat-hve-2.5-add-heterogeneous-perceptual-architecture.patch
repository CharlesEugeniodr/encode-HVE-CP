+from __future__ import annotations
+
+import json
+from pathlib import Path
+from typing import cast
+
+import pytest
+
+from hve.chromatic_topology import (
+    ColorSpace,
+    ColorState,
+    GamutPolicy,
+    HVEProfiledColor,
+    convert_profiled_color_detailed,
+    perceptual_edge_conductance,
+)
+from hve.protocol import make_heterogeneous_chi_refined_frame, pack_chi_refined88
+from hve.refined import HVERefinedState
+
+GOLDEN_PATH = Path(__file__).with_name("golden_vectors_v25.json")
+
+
+def _golden() -> dict[str, object]:
+    return cast(dict[str, object], json.loads(GOLDEN_PATH.read_text(encoding="utf-8")))
+
+
+def _color(record: dict[str, object]) -> HVEProfiledColor:
+    rgb = record["rgb8"]
+    assert isinstance(rgb, list)
+    return HVEProfiledColor(
+        ColorState[str(record["color_state"])],
+        ColorSpace[str(record["color_space"])],
+        int(rgb[0]),
+        int(rgb[1]),
+        int(rgb[2]),
+    )
+
+
+def test_published_cr88_words_and_frame_are_reproducible() -> None:
+    serialization = _golden()["serialization"]
+    assert isinstance(serialization, dict)
+    words = serialization["words"]
+    assert isinstance(words, list)
+    states: list[tuple[HVERefinedState, HVEProfiledColor]] = []
+    for record in words:
+        assert isinstance(record, dict)
+        geometry = record["geometry"]
+        assert isinstance(geometry, list)
+        state = HVERefinedState(*(int(value) for value in geometry))
+        color = _color(record)
+        word = pack_chi_refined88(state, color)
+        assert word.hex() == record["cr88_hex"]
+        assert word[:10].hex() == record["cr80_hex"]
+        assert word[10:].hex() == record["metadata_hex"]
+        states.append((state, color))
+    assert make_heterogeneous_chi_refined_frame(states).hex() == serialization["frame_hex"]
+
+
+def test_published_conversion_vectors_are_reproducible() -> None:
+    conversions = _golden()["conversions"]
+    assert isinstance(conversions, list)
+    for record in conversions:
+        assert isinstance(record, dict)
+        source = record["source"]
+        assert isinstance(source, dict)
+        rgb = source["rgb8"]
+        assert isinstance(rgb, list)
+        color = HVEProfiledColor.valid(
+            ColorSpace[str(source["space"])],
+            *(int(value) for value in rgb),
+        )
+        result = convert_profiled_color_detailed(
+            color,
+            ColorSpace[str(record["target_space"])],
+            GamutPolicy[str(record["policy"])],
+        )
+        assert result.status.name == record["status"]
+        expected_rgb = record["result_rgb8"]
+        actual_rgb = None if result.color is None else [result.color.r, result.color.g, result.color.b]
+        assert actual_rgb == expected_rgb
+        assert result.out_of_gamut is record["out_of_gamut"]
+
+
+def test_published_three_vertex_perceptual_weights_are_reproducible() -> None:
+    perceptual = _golden()["perceptual_laplacian"]
+    assert isinstance(perceptual, dict)
+    vertices = perceptual["vertices"]
+    weights = perceptual["edge_weights"]
+    assert isinstance(vertices, list)
+    assert isinstance(weights, list)
+    colors = [
+        HVEProfiledColor.valid(ColorSpace.SRGB, *(int(value) for value in vertex))
+        for vertex in vertices
+    ]
+    assert perceptual_edge_conductance(colors[0], colors[1]) == pytest.approx(weights[0])
+    assert perceptual_edge_conductance(colors[1], colors[2]) == pytest.approx(weights[1])
