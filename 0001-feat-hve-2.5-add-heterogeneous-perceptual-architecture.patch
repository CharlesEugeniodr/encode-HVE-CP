+def test_conversion_direction_and_typed_outcomes() -> None:
+    srgb_red = HVEProfiledColor.valid(ColorSpace.SRGB, 255, 0, 0)
+    p3_red = HVEProfiledColor.valid(ColorSpace.DISPLAY_P3, 255, 0, 0)
+
+    converted, status = convert_profiled_color(srgb_red, ColorSpace.DISPLAY_P3)
+    assert converted == HVEProfiledColor.valid(ColorSpace.DISPLAY_P3, 234, 51, 35)
+    assert status is ConversionStatus.QUANTIZED
+
+    rejected, status = convert_profiled_color(p3_red, ColorSpace.SRGB, GamutPolicy.REJECT)
+    assert rejected is None
+    assert status is ConversionStatus.OUT_OF_GAMUT
+
+    clipped, status = convert_profiled_color(p3_red, ColorSpace.SRGB, GamutPolicy.CLIP)
+    assert clipped == HVEProfiledColor.valid(ColorSpace.SRGB, 255, 0, 0)
+    assert status is ConversionStatus.CLIPPED
+
+    mapped, status = convert_profiled_color(
+        p3_red,
+        ColorSpace.SRGB,
+        GamutPolicy.MAP_OKLCH_MINDE,
+    )
+    assert mapped == HVEProfiledColor.valid(ColorSpace.SRGB, 255, 11, 12)
+    assert status is ConversionStatus.MAPPED
+
+
+def test_conversion_exact_no_color_and_non_reversibility() -> None:
+    black = HVEProfiledColor.valid(ColorSpace.SRGB, 0, 0, 0)
+    white = HVEProfiledColor.valid(ColorSpace.SRGB, 255, 255, 255)
+    for color in (black, white):
+        converted, status = convert_profiled_color(color, ColorSpace.DISPLAY_P3)
+        assert converted is not None
+        assert status is ConversionStatus.EXACT
+
+    absent, status = convert_profiled_color(HVEProfiledColor.no_color(), ColorSpace.SRGB)
+    assert absent == HVEProfiledColor.no_color()
+    assert status is ConversionStatus.EXACT
+
+    p3_red = HVEProfiledColor.valid(ColorSpace.DISPLAY_P3, 255, 0, 0)
+    clipped, _ = convert_profiled_color(p3_red, ColorSpace.SRGB, GamutPolicy.CLIP)
+    assert clipped is not None
+    roundtrip, _ = convert_profiled_color(clipped, ColorSpace.DISPLAY_P3)
+    assert roundtrip != p3_red
+
+
+def test_conversion_preserves_geometry_and_rejects_uncalibrated_sources() -> None:
+    color = HVEProfiledColor.valid(ColorSpace.SRGB, 255, 0, 0)
+    converted, status = convert_refined_chromatic_state(
+        REFERENCE_STATE,
+        color,
+        ColorSpace.DISPLAY_P3,
+    )
+    assert converted is not None
+    assert converted[0] == REFERENCE_STATE
+    assert status is ConversionStatus.QUANTIZED
+    with pytest.raises(HVEError, match="source profile"):
+        convert_profiled_color(
+            HVEProfiledColor.uncalibrated(1, 2, 3),
+            ColorSpace.SRGB,
+        )
+
+
+def test_conversion_diagnostics_are_explicit() -> None:
+    p3_red = HVEProfiledColor.valid(ColorSpace.DISPLAY_P3, 255, 0, 0)
+    result = convert_profiled_color_detailed(p3_red, ColorSpace.SRGB, GamutPolicy.REJECT)
+    assert result.out_of_gamut
+    assert result.target_linear_unconstrained is not None
+    assert result.target_linear_unconstrained[0] > 1.0
+    assert result.target_linear_unconstrained[1] < 0.0
+    assert result.quantization_delta_e_ok is None
+
+
+def test_gaussian_conductance_uses_native_oklab_scale() -> None:
+    assert OKLAB_GAUSSIAN_SIGMA_DEFAULT == pytest.approx(0.02 / math.sqrt(2.0))
+    assert gaussian_conductance(0.0) == 1.0
+    assert gaussian_conductance(0.02) == pytest.approx(math.exp(-1.0))
+    with pytest.raises(HVEError, match="delta_e"):
+        gaussian_conductance(-1.0)
+    with pytest.raises(HVEError, match="sigma"):
+        gaussian_conductance(0.01, sigma=0.0)
+
+
+def test_perceptual_profile_preserves_structural_adjacency_and_symmetry() -> None:
+    left = HVEProfiledColor.valid(ColorSpace.SRGB, 0, 0, 0)
+    right = HVEProfiledColor.valid(ColorSpace.SRGB, 1, 0, 0)
+    nonneighbor = HVEProfiledColor.valid(ColorSpace.SRGB, 2, 0, 0)
+    before = chromatic_neighbors(left)
+    weight_lr = perceptual_edge_conductance(left, right)
+    weight_rl = perceptual_edge_conductance(right, left)
+    assert chromatic_neighbors(left) == before
+    assert chromatic_graph_distance(left, right) == 1.0
+    assert 0.0 < weight_lr <= 1.0
+    assert weight_lr == pytest.approx(weight_rl)
+    with pytest.raises(HVEError, match="structural"):
+        perceptual_edge_conductance(left, nonneighbor)
+
+
+def test_three_color_weighted_laplacian_is_psd_with_zero_row_sums() -> None:
+    colors = [
+        HVEProfiledColor.valid(ColorSpace.SRGB, 0, 0, 0),
+        HVEProfiledColor.valid(ColorSpace.SRGB, 1, 0, 0),
+        HVEProfiledColor.valid(ColorSpace.SRGB, 2, 0, 0),
+    ]
+    w01 = perceptual_edge_conductance(colors[0], colors[1])
+    w12 = perceptual_edge_conductance(colors[1], colors[2])
+    laplacian = np.array(
+        [
+            [w01, -w01, 0.0],
+            [-w01, w01 + w12, -w12],
+            [0.0, -w12, w12],
+        ],
+        dtype=np.float64,
+    )
+    assert np.allclose(laplacian, laplacian.T)
+    assert np.allclose(laplacian.sum(axis=1), 0.0)
+    assert np.linalg.eigvalsh(laplacian).min() >= -1e-12
+
+
+def test_normative_perceptual_laplacian_is_local() -> None:
+    color = HVEProfiledColor.valid(ColorSpace.SRGB, 0, 0, 0)
+    signal = lambda value: float(value.r + 2 * value.g + 3 * value.b)
+    weighted = chromatic_perceptual_laplacian_at(signal, color)
+    assert -6.0 < weighted < 0.0
