+                            double *difference_out) {
+    double scale = candidate_chroma / source_chroma;
+    double current_lab[3] = {lightness, a_value * scale, b_value * scale};
+    double current_xyz[3];
+    double clipped_xyz[3];
+    double clipped_lab[3];
+    oklab_to_xyz_internal(current_lab, current_xyz);
+    xyz_to_linear_target(current_xyz, target_space, linear_out);
+    clamp_unit(linear_out, clipped_out);
+    linear_target_to_xyz(clipped_out, target_space, clipped_xyz);
+    xyz_to_oklab_internal(clipped_xyz, clipped_lab);
+    *difference_out = euclidean3(current_lab, clipped_lab);
